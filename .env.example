# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).
# For GitHub Actions, add the same names under Settings > Secrets and variables > Actions.

# Phone push alerts (recommended). Install the free "ntfy" app, subscribe to this topic.
# Pick something long and random; anyone who knows the name can read your alerts.
NTFY_TOPIC=trading-agent-change-this-to-something-random-8x2k

# Email alerts (optional). The SENDING account, e.g. a Gmail with an "App password".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.sender@gmail.com
SMTP_PASSWORD=your-16-character-app-password
ALERT_EMAIL_TO=natchapon.sor@hotmail.com
